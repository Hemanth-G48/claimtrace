# ClaimTrace — example environment configuration
#
# Copy to .env and fill in values. .env is gitignored.
#
# Nothing below is required for a static-analysis run: with no keys set, ClaimTrace
# scans with the local analyzers and sends no alerts. The two integrations are
# optional, and the DB defaults to local SQLite.

# === Integrations (optional) ===

# CommandCode API key for LLM triage (default provider). Without it, scans still
# complete via the static rules; LLM triage is skipped.
COMMANDCODE_API_KEY=

# Legacy OpenRouter fallback. If only this key is set, triage uses OpenRouter's
# endpoint automatically. Prefer COMMANDCODE_API_KEY for new installs.
# OPENROUTER_API_KEY=

# Discord webhook for malicious-package alerts (optional). Without it,
# malicious findings still persist to the DB; no alerts are sent.
DISCORD_WEBHOOK_URL=

# === Database ===

# Connection URL. Default is local SQLite (WAL mode) — fine for development.
# For production: postgresql://<user>:<password>@<host>:<port>/<db>
# Note: docker-compose.standalone.yml overrides this automatically — no edit needed.
CLAIMTRACE_DB_URL=sqlite:///claimtrace.db

# === Polite-scraper identity ===

# Contact identifier surfaced in the User-Agent on all outbound requests
# to PyPI, crates.io, and the Go module proxy. Set this to a URL or email
# you control so registry maintainers can reach you if your scanner ever
# misbehaves.
CLAIMTRACE_CONTACT_EMAIL=

# Optional project URL used as the User-Agent contact when no email is set.
# CLAIMTRACE_PROJECT_URL=https://github.com/your-org/claimtrace

# === Ingest control ===

# 1 = poll feeds and enqueue new packages. 0 = drain the existing queue only.
SCANNER_INGEST=1

# Focus packages: load with `claimtrace focus load <file> -e <eco>`.
# 0 = additive (focus packages scanned at high priority plus the normal gates).
# 1 = exclusive (scan ONLY focus-list packages; watchlist + brand-new skipped).
CLAIMTRACE_FOCUS_EXCLUSIVE=0

# Set to 1 to scan Go pseudo-versions. Default skips them (high volume,
# usually transient development snapshots).
GOMOD_SCAN_PSEUDO=0

# === LLM triage ===

# Model identifier. The default is CommandCode's deepseek-v4.1-flash; override
# it with the provider's own id when using a different OpenAI-compatible endpoint.
CLAIMTRACE_LLM_MODEL=deepseek/deepseek-v4.1-flash

# Per-process budget cap in USD. Hard stop — once reached, triage is
# skipped for the rest of the process lifetime.
CLAIMTRACE_LLM_MAX_USD=20.0

# Rate limit. Hard stop on hourly call count.
CLAIMTRACE_LLM_MAX_CALLS_PER_HOUR=1000

# OpenAI-compatible endpoint for triage. Defaults to CommandCode
# (https://api.commandcode.ai/provider/v1). To use OpenRouter instead, set this
# to https://openrouter.ai/api/v1 and provide OPENROUTER_API_KEY.
# CLAIMTRACE_LLM_BASE_URL=https://api.commandcode.ai/provider/v1

# An LLM "malicious" below this confidence cannot escalate a non-malicious rule
# verdict or count toward auto-watchlist promotion. Observed FP escalations sit
# at 0.2-0.55; real malware convicts at >= 0.95.
CLAIMTRACE_LLM_MALICIOUS_CONF_FLOOR=0.7

# === Intel pack overlay ===

# Path to a private intel pack (YARA rules, hash seeds, prompts, thresholds).
# If unset, only the public baseline pack ships with the engine is loaded.
# Operators with their own threat intel should point this at their pack
# directory — see docs/intel-pack.md.
# CLAIMTRACE_INTEL_PATH=/path/to/private/intel/pack

# === opengrep static-analysis layer ===

# Master kill switch. 1 = analyzer is wired into the pipeline.
# 0 = analyzer is skipped entirely (legacy regex/AST layers continue normally).
OPENGREP_ENABLED=1

# Shadow mode. 1 (default) = findings emit as `opengrep.shadow_<id>` and are
# EXCLUDED from scoring. The legacy install-time analyzers (PyPI installer.py,
# Crates build_rs.py) continue to run. This is the prod-safe default.
#
# 0 = findings emit as `opengrep.<id>` and contribute to scoring/verdict.
# The legacy install-time analyzers are SKIPPED. Only flip this after the
# soak-period comparison shows opengrep parity (see docs/opengrep-rules.md).
OPENGREP_SHADOW=1

# Per-package wall-clock timeout for the opengrep subprocess. On timeout the
# analyzer returns no findings and logs `opengrep_timeout` — the rest of the
# scan continues normally.
OPENGREP_TIMEOUT_SEC=60

# Binary path / PATH lookup name. Override only for testing.
# OPENGREP_BIN=opengrep

# === Detonation (dynamic analysis, all ecosystems, optional) ===

# Path to the detonation service UNIX socket. Set if you've deployed the
# Go sandbox service (see docs/detonation.md). Leave unset to run engine
# without dynamic analysis.
# DETONATION_SOCKET=/var/run/detonation/detonation.sock

# TCP fallback if you're running the sandbox on a different host.
# DETONATION_URL=http://detonation-host:8080

# === Second-stage dependency fetch (npm) ===

# When an npm dependency's spec is a raw tarball URL on a suspicious file host
# (cloud bucket / abuse host / paste site), fetch + statically analyze (never
# execute) the second stage so a staged dependency-confusion payload convicts the
# parent at scan time. SSRF-guarded + bounded. The static `installer.npm_url_dependency`
# flag fires regardless; set to 0 to keep the scanner's egress dark. Default on.
# CLAIMTRACE_FETCH_URL_DEPS=1
# CLAIMTRACE_URL_DEP_MAX_MB=20
# CLAIMTRACE_URL_DEP_TIMEOUT=15
# CLAIMTRACE_URL_DEP_MAX_COUNT=3

# === Auto-watchlist control ===

# When a scan is double-confirmed malicious, the package name can be auto-added to
# the watchlist so future releases are re-scanned at high priority. Names listed
# here (comma-separated "ecosystem:name") are NEVER auto-watchlisted — the exit-ramp
# for a false positive. Example:
# WATCHLIST_AUTO_BLOCKLIST=pypi:somepkg,npm:other-pkg

# === Optional ===

# GitHub API token. Improves rate limits when building the Go modules
# watchlist (by-stars query); not required.
GITHUB_TOKEN=
